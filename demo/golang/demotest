#!/bin/bash
# Runs all Go demos to verify they work correctly.
Fail()
{
    echo "FATAL(demo/golang/demotest): $1"
    exit 1
}

go build -o /tmp/astronomy-demo/demobin ./... || Fail "Error building Go demos."
trap 'rm -f /tmp/astronomy-demo/demobin' EXIT

echo "Testing Go demo: positions"
go run . positions +45.6 -90.7 2018-11-30T17:55:07.234Z > /dev/null || Fail "positions"
echo "Testing Go demo: riseset"
go run . riseset 45 -90 2019-06-14T21:45:25Z > /dev/null || Fail "riseset"
echo "Testing Go demo: moonphase"
go run . moonphase 2019-06-15T09:15:32.987Z > /dev/null || Fail "moonphase"
echo "Testing Go demo: seasons"
go run . seasons 2020 > /dev/null || Fail "seasons"
echo "Testing Go demo: culminate"
go run . culminate +30 -90 2015-02-28T00:00:00Z > /dev/null || Fail "culminate"
echo "Testing Go demo: lunar_eclipse"
go run . lunar_eclipse 1988-01-01T00:00:00Z > /dev/null || Fail "lunar_eclipse"
echo "Testing Go demo: solar_time"
go run . solar_time +38.88 -77.03 2023-02-12T17:00:00Z > /dev/null || Fail "solar_time"
echo "Testing Go demo: gravity"
go run . gravity 29.0 1000.0 > /dev/null || Fail "gravity"
echo "Testing Go demo: galactic"
go run . galactic 38.92056 -77.0658 22.793498 197.070510 2025-04-06T00:00:00Z > /dev/null || Fail "galactic"
echo "Testing Go demo: horizon"
go run . horizon +25.5 -85.3 2016-12-25T12:30:45Z > /dev/null || Fail "horizon"

echo "demotest: success"
exit 0
